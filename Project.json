{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Project",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false,
    "developmentLanguage": "en"
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-",
    "SWIFT_EMIT_LOC_STRINGS": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES"
  },
  "targets": {
    "Dipwise": {
      "dependencies": [
        {
          "embed": true,
          "target": "Dipwise Watch"
        },
        {
          "embed": true,
          "target": "Dipwise Widget Extension"
        }
      ],
      "deploymentTarget": "26.0",
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dipwise",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {
            "UIColorName": "LaunchNavy"
          },
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait"
          ],
          "UIBackgroundModes": [
            "fetch"
          ],
          "BGTaskSchedulerPermittedIdentifiers": [
            "dipwise.refresh"
          ],
          "UISupportedInterfaceOrientations~ipad": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "LSApplicationCategoryType": "public.app-category.finance",
          "CFBundleURLTypes": [
            {
              "CFBundleURLName": "app.dipwise",
              "CFBundleURLSchemes": [
                "dipwise"
              ]
            }
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "sources": [
        {
          "path": "App"
        },
        {
          "path": "Shared"
        },
        {
          "path": "Widget Extension/WidgetComponents.swift"
        },
        {
          "path": "Widget Extension/PlansWidget.swift"
        },
        {
          "path": "Widget Extension/PortfolioWidget.swift"
        },
        {
          "path": "Widget Extension/StockPlanWidget.swift"
        },
        {
          "path": "Widget Extension/StreakWidget.swift"
        },
        {
          "path": "Widget Extension/WidgetIntents.swift"
        },
        {
          "path": "Widget Extension/MoversWidget.swift"
        },
        {
          "path": "Widget Extension/FlockWidget.swift"
        }
      ],
      "type": "application",
      "entitlements": {
        "path": "App/App.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e"
          ],
          "com.apple.developer.applesignin": [
            "Default"
          ]
        }
      }
    },
    "Dipwise Watch": {
      "deploymentTarget": "26.0",
      "info": {
        "path": "Watch/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dipwise",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "WKApplication": true,
          "WKCompanionAppBundleIdentifier": "app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e"
        }
      },
      "platform": "watchOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "Watch"
        },
        {
          "path": "App/Assets.xcassets"
        },
        {
          "path": "Shared"
        }
      ],
      "type": "application",
      "dependencies": [
        {
          "embed": true,
          "target": "Dipwise Watch Widget Extension"
        }
      ],
      "entitlements": {
        "path": "Watch/Watch.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e"
          ]
        }
      }
    },
    "Dipwise Widget Extension": {
      "type": "app-extension",
      "platform": "iOS",
      "deploymentTarget": "26.0",
      "sources": [
        {
          "path": "Widget Extension"
        },
        {
          "path": "Shared"
        }
      ],
      "info": {
        "path": "Widget Extension/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dipwise Widget Extension",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "settings": {
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e.widget-extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "entitlements": {
        "path": "Widget Extension/Widget Extension.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e"
          ]
        }
      }
    },
    "Dipwise Watch Widget Extension": {
      "type": "app-extension",
      "platform": "watchOS",
      "deploymentTarget": "26.0",
      "sources": [
        {
          "path": "Watch Widget Extension"
        },
        {
          "path": "Shared"
        }
      ],
      "info": {
        "path": "Watch Widget Extension/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dipwise Watch Widget Extension",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "settings": {
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e.watchkitapp.widget-extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "entitlements": {
        "path": "Watch Widget Extension/Watch Widget Extension.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.new.15b8fdf3-82a6-4223-97a2-c5cc5f8ba55e"
          ]
        }
      }
    }
  }
}