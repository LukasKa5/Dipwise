{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Project",
  "options": {
    "developmentLanguage": "en",
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "SWIFT_EMIT_LOC_STRINGS": "YES"
  },
  "targets": {
    "Dipwise": {
      "dependencies": [
        {
          "embed": true,
          "target": "Dipwise Watch"
        },
        {
          "embed": true,
          "target": "Dipwise Widget Extension"
        }
      ],
      "deploymentTarget": "26.0",
      "entitlements": {
        "path": "App\/App.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.lukaskaniansky.dipwise"
          ]
        }
      },
      "info": {
        "path": "App\/Info.plist",
        "properties": {
          "BGTaskSchedulerPermittedIdentifiers": [
            "dipwise.refresh"
          ],
          "CFBundleDisplayName": "Dipwise",
          "CFBundleShortVersionString": "1.0",
          "CFBundleURLTypes": [
            {
              "CFBundleURLName": "app.dipwise",
              "CFBundleURLSchemes": [
                "dipwise"
              ]
            }
          ],
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "LSApplicationCategoryType": "public.app-category.finance",
          "UIBackgroundModes": [
            "fetch"
          ],
          "UILaunchScreen": {
            "UIColorName": "LaunchNavy"
          },
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "UISupportedInterfaceOrientations~ipad": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.lukaskaniansky.dipwise",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "sources": [
        {
          "path": "App"
        },
        {
          "path": "Shared"
        },
        {
          "path": "Widget Extension\/WidgetComponents.swift"
        },
        {
          "path": "Widget Extension\/PlansWidget.swift"
        },
        {
          "path": "Widget Extension\/PortfolioWidget.swift"
        },
        {
          "path": "Widget Extension\/StockPlanWidget.swift"
        },
        {
          "path": "Widget Extension\/WidgetIntents.swift"
        },
        {
          "path": "Widget Extension\/FlockWidgets.swift"
        },
        {
          "path": "Widget Extension\/MarketWidget.swift"
        }
      ],
      "type": "application"
    },
    "Dipwise Watch": {
      "dependencies": [
        {
          "embed": true,
          "target": "Dipwise Watch Widget Extension"
        }
      ],
      "deploymentTarget": "26.0",
      "entitlements": {
        "path": "Watch\/Watch.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.lukaskaniansky.dipwise"
          ]
        }
      },
      "info": {
        "path": "Watch\/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dipwise",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "WKApplication": true,
          "WKCompanionAppBundleIdentifier": "app.bitrig.lukaskaniansky.dipwise"
        }
      },
      "platform": "watchOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.lukaskaniansky.dipwise.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "Watch"
        },
        {
          "path": "App\/Assets.xcassets"
        },
        {
          "path": "Shared"
        }
      ],
      "type": "application"
    },
    "Dipwise Watch Widget Extension": {
      "deploymentTarget": "26.0",
      "entitlements": {
        "path": "Watch Widget Extension\/Watch Widget Extension.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.lukaskaniansky.dipwise"
          ]
        }
      },
      "info": {
        "path": "Watch Widget Extension\/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dipwise Watch Widget Extension",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "platform": "watchOS",
      "settings": {
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.lukaskaniansky.dipwise.watchkitapp.widget-extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "Watch Widget Extension"
        },
        {
          "path": "Shared"
        }
      ],
      "type": "app-extension"
    },
    "Dipwise Widget Extension": {
      "deploymentTarget": "26.0",
      "entitlements": {
        "path": "Widget Extension\/Widget Extension.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.app.bitrig.lukaskaniansky.dipwise"
          ]
        }
      },
      "info": {
        "path": "Widget Extension\/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Dipwise Widget Extension",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "platform": "iOS",
      "settings": {
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.lukaskaniansky.dipwise.widget-extension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "sources": [
        {
          "path": "Widget Extension"
        },
        {
          "path": "Shared"
        }
      ],
      "type": "app-extension"
    }
  }
}
