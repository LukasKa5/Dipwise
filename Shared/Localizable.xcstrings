    "Before you own something, know where you'd buy more and where you'd take profit. That's a complete plan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du etwas besitzt, wisse, wo du nachkaufst und wo du Gewinne mitnimmst. Das ist ein vollständiger Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de tener algo, sabe dónde comprarías más y dónde recogerías beneficios. Eso es un plan completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de posséder quelque chose, sache où tu achèterais plus et où tu prendrais tes gains. C'est un plan complet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di possedere qualcosa, sappi dove compreresti di più e dove prenderesti profitto. Questo è un piano completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保有する前に、どこで買い増し、どこで利確するかを決めておく。それが完全な計画です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보유하기 전에 어디서 더 사고 어디서 수익을 실현할지 정하세요. 그게 완전한 계획이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de ter algo, saiba onde compraria mais e onde realizaria lucro. Isso é um plano completo."
          }
        }
      }
    },
