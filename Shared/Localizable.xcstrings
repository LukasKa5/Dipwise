          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのDipwiseで銘柄を追加すると、Dippyがここに届けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Dipwise에서 종목을 추가하면 Dippy가 여기로 가져와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione ações no Dipwise no iPhone e o Dippy as traz para cá."
          }
        }
      }
    },
    "Add stocks in Dipwise on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in Dipwise auf dem iPhone Aktien hinzu."
          }
        },
        "es": {
