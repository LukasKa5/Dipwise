    },
    "Your stocks that moved the most today, up and down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aktien, die sich heute am stärksten bewegt haben, nach oben und unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus acciones que más se movieron hoy, al alza y a la baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes actions qui ont le plus bougé aujourd'hui, à la hausse comme à la baisse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue azioni che si sono mosse di più oggi, al rialzo e al ribasso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
