    "Buy the dips and sell the highs with a plan, without watching charts all day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufe Dips und verkaufe Hochs mit Plan, ohne den ganzen Tag Charts zu beobachten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra las caídas y vende los máximos con un plan, sin mirar gráficos todo el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achète les baisses et vends les sommets avec un plan, sans fixer les graphiques toute la journée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra i ribassi e vendi i massimi con un piano, senza guardare i grafici tutto il giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日中チャートを眺めなくても、計画どおりに押し目で買い、高値で売れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 종일 차트를 보지 않고도 계획대로 저점에 사고 고점에 파세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compre nas quedas e venda nas altas com um plano, sem ficar olhando gráficos o dia todo."
          }
        }
      }
    },
