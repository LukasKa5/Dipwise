    "Set shares to 0 to just watch %@. Dipwise never connects to your broker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze die Anteile auf 0, um %@ nur zu beobachten. Dipwise verbindet sich nie mit deinem Broker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon las acciones a 0 para solo seguir %@. Dipwise nunca se conecta a tu bróker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets les actions à 0 pour simplement suivre %@. Dipwise ne se connecte jamais à ton courtier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta le azioni a 0 per osservare soltanto %@. Dipwise non si collega mai al tuo broker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "株数を0にすると、%@を見守るだけになります。Dipwiseが証券会社に接続することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주식 수를 0으로 하면 %@을(를) 지켜보기만 해요. Dipwise는 증권사에 절대 연결하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque 0 ações para só acompanhar %@. O Dipwise nunca se conecta à sua corretora."
          }
        }
      }
    },
