    "Export your positions or trade history from your broker as a CSV file. Dippy finds the tickers, shares, and average cost for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere deine Positionen oder Transaktionen aus deinem Broker als CSV-Datei. Dippy findet Ticker, Anteile und Einstandspreis für dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tus posiciones o tu historial desde tu bróker como archivo CSV. Dippy encuentra los tickers, acciones y precio medio por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte tes positions ou ton historique depuis ton courtier en fichier CSV. Dippy trouve les tickers, les quantités et le prix moyen pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta posizioni o storico operazioni dal tuo broker come file CSV. Dippy trova ticker, quantità e prezzo medio per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証券会社からポジションや取引履歴をCSVでエクスポートしてください。Dippyがティッカー・株数・平均取得価格を見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "증권사에서 보유 종목이나 거래 내역을 CSV 파일로 내보내세요. Dippy가 티커, 수량, 평균 단가를 찾아 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte suas posições ou histórico da corretora como arquivo CSV. O Dippy encontra os tickers, a quantidade e o preço médio para você."
          }
        }
      }
    },
