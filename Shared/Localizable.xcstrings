    "%@. Worked out from %@'s daily moves over the past year, not a prediction.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Berechnet aus den täglichen Bewegungen von %2$@ im letzten Jahr, keine Vorhersage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Calculado con los movimientos diarios de %2$@ del último año, no es una predicción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Calculé à partir des mouvements quotidiens de %2$@ sur l'année écoulée, pas une prédiction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Calcolato dai movimenti giornalieri di %2$@ dell'ultimo anno, non è una previsione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. Calculado a partir dos movimentos diários de %2$@ no último ano, não é uma previsão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。%2$@の過去1年の値動きから計算したもので、予測ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
