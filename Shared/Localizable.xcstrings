    "Buying looks overheated. A moment to consider profits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wirkt überhitzt. Ein Moment, um an Gewinne zu denken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras parecen recalentadas. Buen momento para pensar en beneficios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats semblent en surchauffe. Un moment pour penser à tes gains."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti sembrano surriscaldati. Un momento per pensare ai profitti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買われ過ぎに見えます。利益確定を考えるタイミングです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매수가 과열된 것 같아요. 수익 실현을 고민해 볼 때예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras parecem superaquecidas. Hora de pensar em lucro."
          }
        }
      }
    },
    "Buying power": {
      "localizations": {
        "de": {
          "stringUnit": {
