    "Notifications are off, so Dipwise can't tell you when a target is reached.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind aus, deshalb kann Dipwise dir nicht melden, wenn ein Ziel erreicht wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas, así que Dipwise no puede avisarte cuando se alcance un objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées, Dipwise ne peut donc pas te prévenir quand un objectif est atteint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate, quindi Dipwise non può avvisarti quando un obiettivo viene raggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフのため、目標に到達してもDipwiseからお知らせできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있어 목표 도달 시 Dipwise가 알려 드릴 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desligadas, então o Dipwise não consegue avisar quando um alvo é atingido."
          }
        }
      }
    },
