    },
    "Renews automatically. Cancel anytime in Settings at least 24 hours before renewal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch. Jederzeit in den Einstellungen kündbar, spätestens 24 Stunden vor der Verlängerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente. Cancela cuando quieras en Ajustes, al menos 24 horas antes de la renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique. Résiliable à tout moment dans Réglages, au moins 24 heures avant le renouvellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente. Annulla quando vuoi in Impostazioni, almeno 24 ore prima del rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新されます。更新の24時間前までなら、いつでも設定から解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 갱신돼요. 갱신 24시간 전까지 설정에서 언제든 해지할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova automaticamente. Cancele quando quiser em Ajustes, pelo menos 24 horas antes da renovação."
          }
        }
      }
    },
