    "Now %@, inside %@–%@. Your plan: buy 3 shares.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt %1$@, in %2$@–%3$@. Dein Plan: 3 Aktien kaufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora %1$@, dentro de %2$@–%3$@. Tu plan: comprar 3 acciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant %1$@, dans %2$@–%3$@. Ton plan : acheter 3 actions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora %1$@, dentro %2$@–%3$@. Il tuo piano: comprare 3 azioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora %1$@, dentro de %2$@–%3$@. Seu plano: comprar 3 ações."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在%1$@、%2$@〜%3$@の範囲内。プラン：3株購入。"
          }
        },
        "ko": {
          "stringUnit": {
