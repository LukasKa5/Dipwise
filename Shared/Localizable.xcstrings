            "value": "매수 구간, 매도 구간, 그리고 원하는 만큼 스마트 알림을 고르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma zona de compra, uma de venda e quantos alertas inteligentes quiser."
          }
        }
      }
    },
    "Pick any period to see how prices moved.": {
