    "Pick a buy zone, a sell zone, and as many smart alerts as you like.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Kaufzone, eine Verkaufszone und so viele smarte Alarme, wie du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
