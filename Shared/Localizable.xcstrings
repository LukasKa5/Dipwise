    "Tell me more! I'm all ears. Well, tufts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl mehr! Ich bin ganz Ohr. Na ja, ganz Federohr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Cuéntame más! Soy todo oídos. Bueno, todo plumas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raconte-moi ! Je suis tout ouïe. Enfin, tout aigrettes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccontami! Sono tutto orecchi. Beh, tutto piume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっと教えて！耳を澄ませています。正確には羽角ですが。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 말해 주세요! 귀 기울이고 있어요. 정확히는 귀깃이지만요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte mais! Sou todo ouvidos. Bom, todo penas."
          }
        }
      }
    },
