    "Your money is spread out and your risk is moderate. Brokers see a balanced, long-term investor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Geld ist gestreut, dein Risiko moderat. Broker sehen einen ausgewogenen, langfristigen Anleger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dinero está repartido y tu riesgo es moderado. Los brókers ven un inversor equilibrado a largo plazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton argent est réparti et ton risque modéré. Les courtiers voient un investisseur équilibré de long terme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il denaro è distribuito e il rischio è moderato. I broker vedono un investitore bilanciato di lungo periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資金は分散され、リスクは中程度です。証券会社はバランスの取れた長期投資家とみなします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산이 분산되어 있고 위험은 보통이에요. 증권사는 균형 잡힌 장기 투자자로 봐요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dinheiro está distribuído e o risco é moderado. Corretoras veem um investidor equilibrado de longo prazo."
          }
        }
      }
    },
