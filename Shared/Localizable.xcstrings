    "Your position falls a set amount below what you paid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Position fällt um einen festen Betrag unter deinen Einstandspreis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu posición cae cierta cantidad por debajo de lo que pagaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position passe d'un certain montant sous ton prix d'achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione scende di una certa misura sotto quanto hai pagato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポジションが取得価格から一定幅下がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
