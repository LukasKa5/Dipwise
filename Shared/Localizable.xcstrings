          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal fort sur tes actions aujourd'hui. Dippy continue de chercher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun segnale forte sulle tue azioni oggi. Dippy continua a cercare."
          }
        },
        "ja": {
          "stringUnit": {
