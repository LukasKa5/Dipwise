          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione algumas ações e a coruja vai relatar todo dia."
          }
        }
      }
    },
    "Add a stock, then set a green buy zone or a red sell zone. Dippy watches it day and night.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Aktie hinzu und setze eine grüne Kauf- oder rote Verkaufszone. Dippy wacht Tag und Nacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una acción y fija una zona de compra verde o de venta roja. Dippy vigila día y noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une action, puis fixe une zone d'achat verte ou de vente rouge. Dippy veille jour et nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un'azione e imposta una zona di acquisto verde o di vendita rossa. Dippy veglia giorno e notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銘柄を追加して、緑の買いゾーンか赤の売りゾーンを設定しましょう。Dippyが昼も夜も見守ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종목을 추가하고 초록 매수 구간이나 빨간 매도 구간을 정하세요. Dippy가 밤낮으로 지켜봐요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma ação e defina uma zona de compra verde ou de venda vermelha. Dippy vigia dia e noite."
          }
        }
      }
    },
