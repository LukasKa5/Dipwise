    "Allocation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufteilung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartition"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allocazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配分"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비중"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alocação"
          }
        }
      }
    },
    "Allocation shows how your money is spread across stocks, asset types, and currencies. If one position is a large share of the total, a bad day for it is a bad day for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufteilung zeigt, wie dein Geld auf Aktien, Anlageklassen und Währungen verteilt ist. Ist eine Position ein großer Teil des Ganzen, ist ein schlechter Tag für sie auch einer für dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distribución muestra cómo se reparte tu dinero entre acciones, tipos de activo y divisas. Si una posición pesa mucho, un mal día para ella es un mal día para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La répartition montre comment ton argent se divise entre actions, types d'actifs et devises. Si une position pèse lourd, une mauvaise journée pour elle en est une pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allocazione mostra come il denaro è distribuito tra azioni, tipi di asset e valute. Se una posizione pesa molto, una brutta giornata per lei lo è anche per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配分は、資金が銘柄・資産タイプ・通貨にどう分かれているかを示します。1つのポジションが大きいと、その不調がそのまま自分の不調になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비중은 돈이 종목, 자산 유형, 통화에 어떻게 나뉘어 있는지 보여 줍니다. 한 종목 비중이 크면 그 종목의 나쁜 날이 곧 나의 나쁜 날이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alocação mostra como seu dinheiro se divide entre ações, tipos de ativo e moedas. Se uma posição pesa muito, um dia ruim para ela é um dia ruim para você."
          }
        }
      }
    },
