            "state": "translated",
            "value": "Ajoute des actions dans Dipwise sur ton iPhone, Dippy les apportera ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi azioni in Dipwise sull'iPhone e Dippy le porterà qui."
          }
        },
