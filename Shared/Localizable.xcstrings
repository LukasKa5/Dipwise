    "Knowing where you'd buy more and where you'd take profit turns a hunch into a complete plan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wissen, wo du nachkaufst und wo du Gewinne mitnimmst, macht aus einer Ahnung einen vollständigen Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saber dónde comprarías más y dónde recogerías beneficios convierte una corazonada en un plan completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savoir où tu achèterais plus et où tu prendrais tes gains transforme une intuition en plan complet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapere dove compreresti di più e dove prenderesti profitto trasforma un'intuizione in un piano completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこで買い増し、どこで利確するかが分かれば、勘が完全な計画に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서 더 사고 어디서 수익을 실현할지 알면 감이 완전한 계획이 돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saber onde compraria mais e onde realizaria lucro transforma um palpite em um plano completo."
          }
        }
      }
    },
