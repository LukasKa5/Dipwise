    "Follows the price up and alerts you if it falls from the peak.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt dem Kurs nach oben und meldet sich, wenn er vom Hoch fällt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el precio al alza y te avisa si cae desde el máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le cours à la hausse et t'alerte s'il recule depuis le sommet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue il prezzo al rialzo e ti avvisa se scende dal massimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "株価の上昇に追従し、高値から下がると通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주가 상승을 따라가다 고점에서 떨어지면 알려 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha o preço na alta e avisa se ele cair do pico."
          }
        }
      }
    },
