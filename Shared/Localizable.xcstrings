    "Whether the US market is open, and a countdown to the bell.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob die US-Börse offen ist, und ein Countdown bis zur Glocke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el mercado de EE. UU. está abierto y una cuenta atrás hasta la campana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le marché américain est ouvert, avec un compte à rebours jusqu'à la cloche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il mercato USA è aperto, con il conto alla rovescia alla campanella."
          }
