        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미국 증시 개장 여부와 종소리까지의 카운트다운."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o mercado dos EUA está aberto e uma contagem regressiva até o sino."
          }
        }
      }
    },
    "Whether the market is open, a countdown to the next bell, and the S&P 500 today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob der Markt offen ist, ein Countdown bis zur nächsten Glocke und der S&P 500 heute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el mercado está abierto, la cuenta atrás hasta la próxima campana y el S&P 500 de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le marché est ouvert, le compte à rebours jusqu'à la prochaine cloche et le S&P 500 du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il mercato è aperto, il conto alla rovescia alla prossima campana e l'S&P 500 di oggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o mercado está aberto, a contagem até o próximo sino e o S&P 500 hoje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "市場が開いているか、次の鐘までのカウントダウン、今日のS&P 500。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장이 열렸는지, 다음 종까지 카운트다운, 오늘의 S&P 500."
          }
        }
      }
    },
