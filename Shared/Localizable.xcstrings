    "Price usually stays inside its bands. A touch of the lower band often comes before a bounce.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurs bleibt meist innerhalb seiner Bänder. Eine Berührung des unteren Bands geht oft einer Erholung voraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio suele quedarse dentro de sus bandas. Tocar la banda inferior a menudo precede a un rebote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cours reste en général dans ses bandes. Toucher la bande basse précède souvent un rebond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo di solito resta dentro le bande. Toccare quella inferiore spesso precede un rimbalzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "株価はたいていバンド内に収まります。下のバンドに触れたあとは反発することがよくあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격은 대개 밴드 안에 머물러요. 하단 밴드에 닿은 뒤 반등하는 경우가 많아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço costuma ficar dentro das bandas. Tocar a banda inferior muitas vezes vem antes de um repique."
          }
        }
      }
    },
