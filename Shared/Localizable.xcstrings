    "Dips aren't always bargains": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dips sind nicht immer Schnäppchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las caídas no siempre son gangas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les baisses ne sont pas toujours des affaires"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ribassi non sono sempre occasioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押し目がいつもお買い得とは限らない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하락이 늘 바겐세일은 아니에요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedas nem sempre são pechinchas"
          }
        }
      }
    },
    "Dipwise": {
