        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在%@、%@〜%@の範囲内。計画：少し買う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %@, %@–%@ 범위 안. 계획: 조금 사기."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora %@, dentro de %@–%@. Seu plano: comprar um pouco."
          }
        }
      }
    },
    "Now %@, just %@ away. Ready to take some profit?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt %@, nur noch %@ entfernt. Bereit, Gewinne mitzunehmen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora %@, a solo %@. ¿Listo para recoger beneficios?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant %@, à seulement %@. Prêt à prendre tes gains ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora %@, a solo %@. Pronto a prendere profitto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在%@、あと%@。利確の準備はいいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %@, %@만 남았어요. 수익 실현할 준비됐나요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora %@, a só %@. Pronto para realizar lucro?"
          }
        }
      }
    },
    "Now tell him what to look for. Pick a zone, any smart alerts, or skip for now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag ihm jetzt, worauf er achten soll. Wähle eine Zone, smarte Alarme oder überspringe es vorerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora dile qué vigilar. Elige una zona, alertas inteligentes o sáltalo por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-lui maintenant quoi surveiller. Choisis une zone, des alertes intelligentes, ou passe pour l'instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora digli cosa osservare. Scegli una zona, avvisi smart o salta per ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を見張るか教えてあげましょう。ゾーンやスマートアラートを選ぶか、今はスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 무엇을 지켜볼지 알려 주세요. 구간이나 스마트 알림을 고르거나 지금은 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora diga o que ele deve vigiar. Escolha uma zona, alertas inteligentes ou pule por enquanto."
          }
        }
      }
    },
