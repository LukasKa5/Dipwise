            "value": "이유를 적어 두세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote o porquê"
          }
        }
      }
    },
    "Writing down what you did, and later seeing how it worked out, is the fastest way to improve.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzuschreiben, was du getan hast, und später zu sehen, wie es ausging, ist der schnellste Weg, besser zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotar lo que hiciste y ver después cómo salió es la forma más rápida de mejorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter ce que tu as fait, puis voir comment ça a tourné, est le moyen le plus rapide de progresser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotare cosa hai fatto e vedere poi com'è andata è il modo più rapido per migliorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の行動を書き留め、あとで結果を確かめる。それが上達への最短ルートです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 일을 적고 나중에 결과를 확인하는 게 가장 빨리 나아지는 길이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotar o que você fez e depois ver como se saiu é o jeito mais rápido de melhorar."
          }
        }
      }
    },
