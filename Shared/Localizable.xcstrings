    "Your votes make the crowd's mood more accurate for everyone, including you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimmen machen die Marktstimmung für alle genauer, auch für dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus votos hacen más preciso el ánimo de la multitud para todos, también para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes votes rendent l'humeur de la foule plus juste pour tous, toi compris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi voti rendono l'umore della folla più preciso per tutti, anche per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの投票で、みんなのムードがあなたを含む全員にとってより正確になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 투표가 나를 포함한 모두에게 대중 분위기를 더 정확하게 만들어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus votos deixam o humor da multidão mais preciso para todos, inclusive você."
          }
        }
      }
    },
