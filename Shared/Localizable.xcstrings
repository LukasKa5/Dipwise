    "Add a budget to a buy zone to plan how much you'll invest when it triggers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einer Kaufzone ein Budget, um zu planen, wie viel du investierst, wenn sie auslöst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un presupuesto a una zona de compra para planear cuánto invertirás cuando salte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un budget à une zone d'achat pour prévoir combien tu investiras quand elle se déclenche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un budget a una zona di acquisto per pianificare quanto investirai quando scatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買いゾーンに予算を設定すると、作動時の投資額を計画できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매수 구간에 예산을 정해 알림이 울릴 때 얼마를 투자할지 계획하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um orçamento à zona de compra para planejar quanto vai investir quando disparar."
          }
        }
      }
    },
    "Add a few stocks and the owl will report on them every day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein paar Aktien hinzu, und die Eule berichtet jeden Tag darüber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade algunas acciones y el búho te informará cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute quelques actions et la chouette t'en parlera chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualche azione e il gufo te ne parlerà ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銘柄をいくつか追加すると、フクロウが毎日報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
