    "The 50-day average crossed below the 200-day recently.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 50-Tage-Durchschnitt hat kürzlich den 200-Tage-Durchschnitt nach unten gekreuzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
