    "Stocks you already watch get their shares and average cost updated. Tap a row to leave it out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Aktien, die du schon beobachtest, werden Anteile und Einstandspreis aktualisiert. Tippe auf eine Zeile, um sie auszulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones que ya sigues actualizarán sus acciones y precio medio. Toca una fila para excluirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions déjà suivies verront leur quantité et prix moyen mis à jour. Touche une ligne pour l'exclure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le azioni che già segui verranno aggiornati quantità e prezzo medio. Tocca una riga per escluderla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに見守っている銘柄は株数と平均取得価格が更新されます。行をタップすると除外できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 지켜보는 종목은 주식 수와 평균 단가가 업데이트돼요. 행을 탭하면 제외할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações que você já acompanha terão quantidade e preço médio atualizados. Toque em uma linha para deixá-la de fora."
          }
        }
      }
    },
