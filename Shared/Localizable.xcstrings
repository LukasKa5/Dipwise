    "…and tell you when it's time to act.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "…und dir sagen, wann es Zeit zu handeln ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "…y te avisaré cuando sea hora de actuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "…et te dire quand il est temps d'agir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "…e ti dirò quando è il momento di agire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "…そして行動すべき時を知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "…그리고 행동할 때를 알려 줄게요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "…e avisar quando for hora de agir."
          }
        }
      }
