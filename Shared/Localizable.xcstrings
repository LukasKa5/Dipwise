    "Your portfolio and every buy zone on your Home Screen, spelled out so a glance is enough.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Portfolio und jede Kaufzone auf dem Home-Bildschirm, so klar formuliert, dass ein Blick genügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cartera y cada zona de compra en la pantalla de inicio, tan claras que basta un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton portefeuille et chaque zone d'achat sur l'écran d'accueil, si clairs qu'un coup d'œil suffit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio e ogni zona di acquisto nella schermata Home, così chiari che basta un'occhiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートフォリオとすべての買いゾーンをホーム画面に。ひと目で分かるように表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트폴리오와 모든 매수 구간을 홈 화면에. 한눈에 알 수 있게 보여 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua carteira e cada zona de compra na Tela de Início, tão claras que uma olhada basta."
          }
        }
      }
    },
    "Your portfolio swings about %@ in a typical year.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Portfolio schwankt in einem typischen Jahr um etwa %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cartera oscila alrededor de un %@ en un año típico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton portefeuille varie d'environ %@ sur une année type."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio oscilla di circa il %@ in un anno tipico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートフォリオは平均的な1年で約%@変動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트폴리오는 보통 1년에 약 %@ 변동해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua carteira oscila cerca de %@ em um ano típico."
          }
        }
      }
    },
    "Your portfolio value and today's change.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Portfoliowert und die heutige Veränderung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de tu cartera y el cambio de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur de ton portefeuille et la variation du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore del portafoglio e la variazione di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートフォリオの評価額と今日の変動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
