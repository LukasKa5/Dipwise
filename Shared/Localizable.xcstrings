    "%@ dropped 8%% or more from a recent high %lld %@ in the past year.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fiel im letzten Jahr %lld-mal (%@) um 8 %% oder mehr von einem Hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cayó un 8 %% o más desde un máximo reciente %lld %@ en el último año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a chuté de 8 %% ou plus depuis un sommet récent %lld %@ au cours de l'année."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è sceso dell'8%% o più da un massimo recente %lld %@ nell'ultimo anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は過去1年で直近高値から8%%以上の下落が%lld%@ありました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 지난 1년간 최근 고점 대비 8%% 이상 하락이 %lld%@ 있었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caiu 8%% ou mais de uma máxima recente %lld %@ no último ano."
          }
        }
      }
    },
