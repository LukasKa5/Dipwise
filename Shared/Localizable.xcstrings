    "Stocks the Dipwise crowd is buying right now, and how bullish everyone feels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktien, die die Dipwise-Masse gerade kauft, und wie optimistisch alle sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones que la multitud de Dipwise compra ahora y lo optimistas que están todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions que la foule Dipwise achète en ce moment, et l'optimisme général."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni che la folla di Dipwise sta comprando ora e quanto sono ottimisti tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseのみんなが今買っている銘柄と、みんなの強気度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise 사람들이 지금 사는 종목과 모두가 얼마나 낙관적인지."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações que a multidão do Dipwise está comprando agora e o quanto todos estão otimistas."
          }
        }
      }
    },
    "Stocks trading inside the range where most investors plan to buy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktien, die im Bereich handeln, in dem die meisten Anleger kaufen wollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones que cotizan dentro del rango donde la mayoría planea comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions qui cotent dans la fourchette où la plupart des investisseurs prévoient d'acheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azioni che quotano nell'intervallo in cui la maggior parte degli investitori vuole comprare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの投資家が買いを予定している価格帯で取引されている銘柄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 투자자가 사려는 가격대에서 거래되는 종목."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações negociadas na faixa onde a maioria dos investidores planeja comprar."
          }
        }
      }
    },
    "Stocks with a plan": {
      "localizations": {
