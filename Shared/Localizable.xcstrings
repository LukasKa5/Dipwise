    "Drag the green handles to the range where you'd happily buy %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die grünen Griffe auf den Bereich, in dem du gern %@ kaufst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controles verdes al rango donde comprarías %@ con gusto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser les poignées vertes sur la fourchette où tu achèterais volontiers %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
