    "Set 8% while a stock is $100. It rises to $150, so the stop moves up to $138.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle 8 % ein, wenn eine Aktie bei 100 $ steht. Steigt sie auf 150 $, wandert der Stop auf 138 $."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija un 8 % cuando una acción está a 100 $. Si sube a 150 $, el stop sube a 138 $."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle 8 % quand une action est à 100 $. Si elle monte à 150 $, le stop passe à 138 $."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'8% quando un'azione è a 100 $. Se sale a 150 $, lo stop sale a 138 $."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "株価100ドルのときに8%に設定。150ドルまで上がると、ストップは138ドルに上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주가 100달러일 때 8%로 설정하세요. 150달러로 오르면 손절가도 138달러로 올라가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina 8% com a ação a US$ 100. Se ela subir para US$ 150, o stop sobe para US$ 138."
          }
        }
      }
    },
