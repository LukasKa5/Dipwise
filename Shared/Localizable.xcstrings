    "The 50-day average crossed above the 200-day recently.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 50-Tage-Durchschnitt hat kürzlich den 200-Tage-Durchschnitt nach oben gekreuzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La media de 50 días cruzó al alza la de 200 días recientemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La moyenne à 50 jours a récemment croisé la moyenne à 200 jours à la hausse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La media a 50 giorni ha incrociato al rialzo quella a 200 giorni di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近、50日移動平均が200日移動平均を上抜けました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 50일 평균이 200일 평균을 상향 돌파했어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A média de 50 dias cruzou para cima a de 200 dias recentemente."
          }
