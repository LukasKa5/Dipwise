    "Earn XP by doing your daily brief, setting plans, voting, and logging decisions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle XP mit dem Tagesbriefing, Plänen, Abstimmungen und Tagebucheinträgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana XP con el resumen diario, creando planes, votando y anotando decisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne de l'XP avec le briefing, tes plans, tes votes et ton journal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagna XP con il briefing, i piani, i voti e il diario delle decisioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デイリーブリーフ、プラン作成、投票、判断の記録でXPを獲得。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데일리 브리핑, 계획 세우기, 투표, 결정 기록으로 XP를 얻으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhe XP com o resumo diário, planos, votos e registros de decisões."
          }
        }
      }
    },
    "Earned through steady habits: briefs, plans, votes, and journaling. Dippy is proud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdient durch beständige Gewohnheiten: Briefings, Pläne, Stimmen und Tagebuch. Dippy ist stolz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganado con hábitos constantes: resúmenes, planes, votos y diario. Dippy está orgulloso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagné grâce à des habitudes régulières : briefings, plans, votes et journal. Dippy est fier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagnato con abitudini costanti: briefing, piani, voti e diario. Dippy è orgoglioso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリーフ、プラン、投票、ジャーナルの積み重ねで獲得。Dippyも誇らしげです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리핑, 계획, 투표, 일지라는 꾸준한 습관으로 얻었어요. Dippy가 뿌듯해해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conquistado com hábitos constantes: resumos, planos, votos e diário. Dippy está orgulhoso."
          }
        }
      }
    },
