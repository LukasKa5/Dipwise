    "No strong signals on your stocks today. Dippy keeps scanning.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute keine starken Signale bei deinen Aktien. Dippy sucht weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
