    "Leave this off to simply watch the stock. Dipwise never connects to your broker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das aus, um die Aktie nur zu beobachten. Dipwise verbindet sich nie mit deinem Broker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo desactivado para solo seguir la acción. Dipwise nunca se conecta a tu bróker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse désactivé pour simplement suivre l'action. Dipwise ne se connecte jamais à ton courtier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia disattivato per seguire soltanto l'azione. Dipwise non si collega mai al tuo broker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銘柄を見守るだけならオフのままで。Dipwiseが証券会社に接続することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종목만 지켜보려면 꺼 두세요. Dipwise는 증권사에 절대 연결하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe desligado para só acompanhar a ação. O Dipwise nunca se conecta à sua corretora."
          }
        }
      }
    },
