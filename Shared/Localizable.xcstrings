    "An investor you follow added to %@. Tap to see their portfolio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anleger, dem du folgst, hat %@ aufgestockt. Tippe, um das Portfolio zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un inversor que sigues compró más %@. Toca para ver su cartera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un investisseur que tu suis a renforcé %@. Touche pour voir son portefeuille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un investitore che segui ha aumentato %@. Tocca per vedere il portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォロー中の投資家が%@を買い増しました。タップしてポートフォリオを見る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
