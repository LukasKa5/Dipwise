          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise Pro"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise Pro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise Pro"
          }
        }
      }
    },
    "Dipwise checks prices in the background several times an hour. iOS decides the exact timing. Quiet delivery won't break through Focus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise prüft Kurse mehrmals pro Stunde im Hintergrund. iOS bestimmt den genauen Zeitpunkt. Leise Zustellung durchbricht keinen Fokus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise revisa los precios en segundo plano varias veces por hora. iOS decide el momento exacto. La entrega silenciosa no rompe el modo Concentración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise vérifie les cours en arrière-plan plusieurs fois par heure. iOS décide du moment exact. La distribution discrète ne perce pas les modes de concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise controlla i prezzi in background più volte all'ora. iOS decide il momento esatto. La consegna silenziosa non supera la modalità Full immersion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseはバックグラウンドで1時間に数回株価を確認します。正確なタイミングはiOSが決めます。目立たない配信は集中モードを妨げません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise는 백그라운드에서 시간당 여러 번 시세를 확인합니다. 정확한 시점은 iOS가 정해요. 조용한 전달은 집중 모드를 방해하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dipwise verifica preços em segundo plano várias vezes por hora. O iOS decide o momento exato. A entrega silenciosa não fura o Foco."
          }
        }
      }
    },
    "Dipwise compares this with today's price so you can see how your decisions worked out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise vergleicht das mit dem heutigen Kurs, damit du siehst, wie deine Entscheidungen ausgingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise lo compara con el precio actual para que veas cómo salieron tus decisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise compare avec le cours du jour pour que tu voies comment tes décisions ont tourné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise lo confronta con il prezzo di oggi per mostrarti come sono andate le tue decisioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseが今日の株価と比べ、判断の結果を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise가 오늘 가격과 비교해 결정의 결과를 보여 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dipwise compara com o preço de hoje para você ver como suas decisões se saíram."
          }
        }
      }
    },
    "Dipwise does not track you across apps or websites, does not use advertising identifiers, and does not include third-party analytics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise verfolgt dich nicht über Apps oder Websites hinweg, nutzt keine Werbe-IDs und enthält keine Analyse-Tools von Drittanbietern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise no te rastrea entre apps ni webs, no usa identificadores publicitarios ni incluye analíticas de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise ne te suit pas d'une app ou d'un site à l'autre, n'utilise pas d'identifiant publicitaire et n'inclut aucune analyse tierce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise non ti traccia tra app o siti, non usa identificatori pubblicitari e non include analisi di terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseはアプリやサイトをまたいだトラッキングをせず、広告IDやサードパーティの解析も使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise는 앱이나 웹사이트를 넘나들며 추적하지 않고, 광고 식별자나 제3자 분석 도구도 쓰지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dipwise não rastreia você entre apps ou sites, não usa identificadores de publicidade e não inclui análises de terceiros."
          }
        }
      }
    },
    "Dipwise is built so your money stays your business. There are no ads, no trackers, and no data sales.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise ist so gebaut, dass dein Geld deine Sache bleibt. Keine Werbung, keine Tracker, kein Datenverkauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise está hecho para que tu dinero siga siendo cosa tuya. Sin anuncios, sin rastreadores y sin venta de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise est conçu pour que ton argent reste ton affaire. Pas de pub, pas de traceurs, aucune vente de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise è fatto perché i tuoi soldi restino affari tuoi. Niente pubblicità, niente tracker, nessuna vendita di dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseは、あなたのお金があなただけのものであるように作られています。広告、トラッカー、データ販売は一切ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise는 내 돈이 나만의 일로 남도록 만들어졌어요. 광고, 추적기, 데이터 판매가 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dipwise foi feito para que seu dinheiro continue sendo assunto seu. Sem anúncios, sem rastreadores e sem venda de dados."
          }
        }
      }
    },
    "Dipwise is not a broker and does not give investment advice. Odds, crowd statistics, and signals are information, not recommendations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise ist kein Broker und gibt keine Anlageberatung. Chancen, Schwarm-Statistiken und Signale sind Informationen, keine Empfehlungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise no es un bróker ni da asesoramiento de inversión. Las probabilidades, estadísticas de la multitud y señales son información, no recomendaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise n'est pas un courtier et ne donne pas de conseil en investissement. Probabilités, statistiques de la foule et signaux sont des informations, pas des recommandations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise non è un broker e non fornisce consulenza. Probabilità, statistiche della folla e segnali sono informazioni, non raccomandazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseは証券会社ではなく、投資助言は行いません。確率、みんなの統計、シグナルは情報であり、推奨ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise는 증권사가 아니며 투자 조언을 하지 않아요. 확률, 대중 통계, 시그널은 정보일 뿐 추천이 아니에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dipwise não é corretora e não dá recomendação de investimento. Chances, estatísticas da multidão e sinais são informação, não recomendação."
          }
        }
      }
    },
    "Dipwise is not a broker, does not execute trades, and does not provide investment advice. Market data may be delayed and is provided for information only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise ist kein Broker, führt keine Trades aus und bietet keine Anlageberatung. Marktdaten können verzögert sein und dienen nur zur Information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise no es un bróker, no ejecuta operaciones ni da asesoramiento de inversión. Los datos de mercado pueden tener retraso y son solo informativos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise n'est pas un courtier, n'exécute pas d'ordres et ne fournit pas de conseil en investissement. Les données de marché peuvent être différées et sont fournies à titre informatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise non è un broker, non esegue operazioni e non fornisce consulenza finanziaria. I dati di mercato possono essere ritardati e sono solo informativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseは証券会社ではなく、取引の執行や投資助言は行いません。市場データは遅延する場合があり、情報提供のみを目的としています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise는 증권사가 아니며 거래를 체결하거나 투자 자문을 제공하지 않습니다. 시장 데이터는 지연될 수 있으며 참고용입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dipwise não é uma corretora, não executa ordens e não oferece recomendação de investimento. Dados de mercado podem ter atraso e são apenas informativos."
          }
        }
      }
    },
    "Dipwise sits between you and your broker, watching your plan so you don't have to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise steht zwischen dir und deinem Broker und behält deinen Plan im Blick, damit du es nicht musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise está entre tú y tu bróker, vigilando tu plan para que tú no tengas que hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise se place entre toi et ton courtier et surveille ton plan pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise sta tra te e il tuo broker e controlla il piano al posto tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseはあなたと証券会社の間に立ち、代わりに計画を見守ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise가 나와 증권사 사이에서 계획을 대신 지켜봐요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dipwise fica entre você e sua corretora, vigiando seu plano para você não precisar."
          }
        }
      }
    },
    "Dipwise widget. Tap to see it update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise-Widget. Tippe, um es aktualisiert zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget de Dipwise. Toca para verlo actualizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget Dipwise. Touche pour le voir se mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget di Dipwise. Tocca per vederlo aggiornarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwiseウィジェット。タップすると更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipwise 위젯. 탭하면 업데이트돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget do Dipwise. Toque para vê-lo atualizar."
          }
        }
      }
    },
    "Dipwise: no plans": {
      "localizations": {
