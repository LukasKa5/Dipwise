        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RSI는 0~100 사이예요. 30 미만이면 보통 과매도라고 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
