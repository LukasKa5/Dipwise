    "RSI ranges from 0 to 100. Below 30 is usually called oversold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der RSI reicht von 0 bis 100. Unter 30 gilt meist als überverkauft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El RSI va de 0 a 100. Por debajo de 30 suele considerarse sobreventa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le RSI va de 0 à 100. Sous 30, on parle en général de survente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'RSI va da 0 a 100. Sotto 30 di solito si parla di ipervenduto."
