    "Market data may be delayed. Dipwise is not a broker and doesn't give investment advice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Marktdaten können verzögert sein. Dipwise ist kein Broker und gibt keine Anlageberatung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de mercado pueden tener retraso. Dipwise no es un bróker ni da asesoramiento de inversión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de marché peuvent être différées. Dipwise n'est pas un courtier et ne donne pas de conseil en investissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di mercato possono essere ritardati. Dipwise non è un broker e non fornisce consulenza finanziaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "市場データは遅延する場合があります。Dipwiseは証券会社ではなく、投資助言は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시장 데이터는 지연될 수 있어요. Dipwise는 증권사가 아니며 투자 자문을 하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de mercado podem ter atraso. O Dipwise não é corretora e não dá recomendação de investimento."
          }
        }
      }
    },
