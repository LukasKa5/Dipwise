    "Plans couldn't be loaded. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pläne konnten nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los planes. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les plans. Vérifie ta connexion et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i piani. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを読み込めませんでした。接続を確認して再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
