    "Your own alerts stay private. Only the price levels are shared, never your name or holdings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Alarme bleiben privat. Nur die Preismarken werden geteilt, nie dein Name oder deine Bestände."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus alertas siguen siendo privadas. Solo se comparten los niveles de precio, nunca tu nombre ni tus posiciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes alertes restent privées. Seuls les niveaux de prix sont partagés, jamais ton nom ni tes positions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi avvisi restano privati. Si condividono solo i livelli di prezzo, mai il tuo nome o le tue posizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのアラートは非公開です。共有されるのは価格水準だけで、名前や保有は共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 알림은 비공개예요. 가격대만 공유되고, 이름이나 보유 종목은 절대 공유되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus alertas continuam privados. Só os níveis de preço são compartilhados, nunca seu nome ou suas posições."
          }
        }
      }
    },
    "Your patience paid off: the price came to you instead of you chasing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Geduld hat sich gelohnt: Der Kurs kam zu dir, statt dass du ihm hinterherliefst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu paciencia dio frutos: el precio vino a ti en lugar de perseguirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta patience a payé : le cours est venu à toi au lieu que tu lui coures après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua pazienza ha ripagato: il prezzo è venuto da te invece di inseguirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辛抱が報われました。株価を追いかけずに、株価のほうからやって来ました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인내가 보상받았어요. 가격을 쫓지 않고 가격이 찾아왔어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua paciência valeu: o preço veio até você, em vez de você correr atrás dele."
          }
        }
      }
    },
