    "Distribution of crowd alerts around today's price": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilung der Schwarm-Alarme um den heutigen Kurs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribución de las alertas de la multitud alrededor del precio actual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartition des alertes de la foule autour du cours actuel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuzione degli avvisi della folla attorno al prezzo di oggi"
          }
        },
        "ja": {
