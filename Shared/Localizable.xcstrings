    },
    "Dippy is watching everything now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy hat jetzt alles im Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy lo vigila todo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy surveille tout maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy ora tiene d'occhio tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippyがすべてを見守っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Dippy가 모든 것을 지켜봐요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy está de olho em tudo agora."
          }
        }
      }
    },
    "Dippy taps you the second a stock reaches your zone, with your plan right in the alert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy tippt dich an, sobald eine Aktie deine Zone erreicht, mit deinem Plan direkt im Alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy te avisa en cuanto una acción llega a tu zona, con tu plan en la propia alerta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy te prévient dès qu'une action atteint ta zone, avec ton plan dans l'alerte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy ti avvisa appena un'azione raggiunge la tua zona, con il piano direttamente nell'avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銘柄がゾーンに届いた瞬間、Dippyが計画付きで知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종목이 구간에 도달하는 순간 Dippy가 계획과 함께 알려 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dippy avisa no instante em que uma ação chega à sua zona, com seu plano no próprio alerta."
          }
        }
      }
    },
    "Dippy the owl": {
      "localizations": {
