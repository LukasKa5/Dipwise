    "%@ is %@ of your portfolio. Consider whether that concentration fits your plan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macht %@ deines Portfolios aus. Prüfe, ob diese Konzentration zu deinem Plan passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es el %@ de tu cartera. Valora si esa concentración encaja con tu plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ représente %@ de ton portefeuille. Vérifie si cette concentration convient à ton plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è il %@ del tuo portafoglio. Valuta se questa concentrazione è adatta al tuo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はポートフォリオの%@を占めています。この集中度が計画に合うか考えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 포트폴리오의 %@를 차지합니다. 이 집중도가 계획에 맞는지 생각해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é %@ da sua carteira. Veja se essa concentração combina com seu plano."
          }
        }
      }
    },
